      "name": "Booking Received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 340],
      "webhookId": "streamline-booking-webhook"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'received' }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "f8e6d4c2-b0a8-5f3e-9c7b-1a2f4e6d8c0a",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 340],
      "notes": "Responds immediately so the booking page doesn't hang. Emails send after this."
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.ownerEmail }}",
        "subject": "=New Booking Request — {{ $json.body.customer.name }}",
        "emailType": "html",
        "message": "=`<!DOCTYPE html><html><head><meta charset='UTF-8'><style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f9fafb;margin:0;padding:24px}.container{max-width:520px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.08)}.header{background:#7B3FE4;padding:24px 28px}.header h1{color:#fff;font-size:20px;font-weight:600;margin:0}.header p{color:rgba(255,255,255,.75);font-size:14px;margin:4px 0 0}.body{padding:28px}.label{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#9ca3af;margin-bottom:4px}.value{font-size:15px;color:#111827;font-weight:500;margin-bottom:16px}.booking-card{background:#f8f5ff;border-left:3px solid #7B3FE4;border-radius:0 8px 8px 0;padding:16px 18px;margin-bottom:20px}.booking-card .row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #e9d8fd;font-size:14px}.booking-card .row:last-child{border-bottom:none}.booking-card .key{color:#6b7280}.booking-card .val{font-weight:600;color:#111827}.note-box{background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:12px 14px;font-size:14px;color:#374151;font-style:italic;margin-bottom:20px}.footer{padding:16px 28px;background:#f9fafb;border-top:1px solid #f3f4f6;font-size:12px;color:#9ca3af}</style></head><body><div class='container'><div class='header'><h1>New Booking Request 📅</h1><p>${$json.body.businessName}</p></div><div class='body'><div class='label'>Customer</div><div class='value'>${$json.body.customer.name}</div><div class='label'>Contact</div><div class='value'>${$json.body.customer.email} · ${$json.body.customer.phone}</div><div class='booking-card'><div class='row'><span class='key'>Service</span><span class='val'>${$json.body.booking.service}</span></div><div class='row'><span class='key'>Date</span><span class='val'>${$json.body.booking.dateFormatted}</span></div><div class='row'><span class='key'>Time</span><span class='val'>${$json.body.booking.timeFormatted}</span></div><div class='row'><span class='key'>Duration</span><span class='val'>${$json.body.booking.duration} min</span></div><div class='row'><span class='key'>Price</span><span class='val'>${$json.body.booking.price}</span></div></div>${$json.body.customer.note ? '<div class=\\'label\\'>Customer Note</div><div class=\\'note-box\\'>&ldquo;' + $json.body.customer.note + '&rdquo;</div>' : ''}<p style='font-size:14px;color:#374151;line-height:1.6'>Please contact <strong>${$json.body.customer.name}</strong> to confirm this booking. Reply to their email or WhatsApp them directly.</p></div><div class='footer'>Sent by Streamline Automations · Your booking system is running 24/7</div></div></body></html>`",
        "options": {}
      },
      "id": "a1b3c5d7-e9f1-4a2b-8c6d-0e2f4a6b8c0d",
