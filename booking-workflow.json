          "matchingColumns": [],
          "schema": [
            { "id": "Timestamp",      "displayName": "Timestamp",      "type": "string", "required": false, "defaultMatch": false, "canBeUsedToMatch": true },
            { "id": "Business",       "displayName": "Business",       "type": "string", "required": false, "defaultMatch": false, "canBeUsedToMatch": true },
