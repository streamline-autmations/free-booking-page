      },
      "notes": "Connect your Gmail credential. Sends to the owner's email from the booking payload."
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.customer.email }}",
        "subject": "=Booking Request Received — {{ $json.body.businessName }}",
        "emailType": "html",
        "message": "=`<!DOCTYPE html><html><head><meta charset='UTF-8'><style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f9fafb;margin:0;padding:24px}.container{max-width:520px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.08)}.header{background:#111827;padding:24px 28px;text-align:center}.header h1{color:#fff;font-size:20px;font-weight:600;margin:0}.header p{color:rgba(255,255,255,.6);font-size:14px;margin:6px 0 0}.body{padding:28px}.greeting{font-size:16px;color:#111827;font-weight:500;margin-bottom:8px}.subtext{font-size:14px;color:#6b7280;line-height:1.6;margin-bottom:24px}.booking-card{background:#f9fafb;border-radius:10px;padding:18px;margin-bottom:24px}.booking-card .title{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#9ca3af;margin-bottom:12px}.booking-card .row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f3f4f6;font-size:14px}.booking-card .row:last-child{border-bottom:none}.booking-card .key{color:#6b7280}.booking-card .val{font-weight:600;color:#111827}.notice{background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:12px 14px;font-size:13px;color:#92400e;margin-bottom:20px;line-height:1.5}.footer{padding:16px 28px;background:#f9fafb;border-top:1px solid #f3f4f6;font-size:12px;color:#9ca3af;text-align:center}</style></head><body><div class='container'><div class='header'><h1>${$json.body.businessName}</h1><p>Booking Request Received</p></div><div class='body'><div class='greeting'>Hi ${$json.body.customer.name.split(' ')[0]} 👋</div><div class='subtext'>Thanks for booking with ${$json.body.businessName}! We've received your request and will confirm your appointment shortly.</div><div class='booking-card'><div class='title'>Your Booking Details</div><div class='row'><span class='key'>Service</span><span class='val'>${$json.body.booking.service}</span></div><div class='row'><span class='key'>Date</span><span class='val'>${$json.body.booking.dateFormatted}</span></div><div class='row'><span class='key'>Time</span><span class='val'>${$json.body.booking.timeFormatted}</span></div><div class='row'><span class='key'>Duration</span><span class='val'>${$json.body.booking.duration} min</span></div><div class='row'><span class='key'>Price</span><span class='val'>${$json.body.booking.price}</span></div></div><div class='notice'>⏳ <strong>Pending confirmation</strong> — ${$json.body.businessName} will contact you to confirm this booking. Please wait for their message before assuming it's locked in.</div><p style='font-size:14px;color:#6b7280;line-height:1.6'>Questions? Reply to this email or contact ${$json.body.businessName} directly.</p></div><div class='footer'>Booking powered by Streamline Automations</div></div></body></html>`",
        "options": {
          "replyTo": "={{ $json.body.ownerEmail }}"
        }
      },
      "id": "b2c4d6e8-f0a2-5b3c-9d7e-1f3a5b7c9d1e",
      "name": "Customer Confirmation Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [900, 340],
      "onError": "continueRegularOutput",
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      },
      "notes": "Reply-To is set to ownerEmail so customer replies land in the salon owner's inbox, not yours."
    },
