            { "id": "Service",        "displayName": "Service",        "type": "string", "required": false, "defaultMatch": false, "canBeUsedToMatch": true },
            { "id": "Date",           "displayName": "Date",           "type": "string", "required": false, "defaultMatch": false, "canBeUsedToMatch": true },
            { "id": "Time",           "displayName": "Time",           "type": "string", "required": false, "defaultMatch": false, "canBeUsedToMatch": true },
            { "id": "Duration (min)", "displayName": "Duration (min)", "type": "string", "required": false, "defaultMatch": false, "canBeUsedToMatch": true },
            { "id": "Price",          "displayName": "Price",          "type": "string", "required": false, "defaultMatch": false, "canBeUsedToMatch": true },
